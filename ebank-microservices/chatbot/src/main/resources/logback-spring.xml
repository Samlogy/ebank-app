<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Read from Spring environment — populated before any log line is emitted -->
    <springProperty scope="context" name="SERVICE_NAME" source="spring.application.name" defaultValue="chatbot-service"/>
    <springProperty scope="context" name="LOKI_URL"     source="loki.url"                defaultValue="http://loki:3100/loki/api/v1/push"/>

    <!-- ================================================================
         LOCAL / TEST — colored, human-readable console
    ================================================================ -->
    <springProfile name="local,test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>%boldGreen(%d{dd-MM-yyyy HH:mm:ss.SSS}) %highlight(%-5level) %magenta([%thread]) --- %logger{36} [%X{traceId:-no-trace}] : %replace(%msg){'[\r\n]', ''}%nopex%n%boldRed(%throwable)</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ================================================================
         DOCKER / RECF / PROD — logfmt console + push to Loki
    ================================================================ -->
    <springProfile name="docker,recf,prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>level=%-5level service=${SERVICE_NAME} traceId=%X{traceId:-none} spanId=%X{spanId:-none} logger=%logger{36} | %replace(%msg){'[\r\n]', ''}%nopex%n</pattern>
            </encoder>
        </appender>

        <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
            <http>
                <url>${LOKI_URL}</url>
                <batchTimeoutMs>1000</batchTimeoutMs>
                <batchMaxItems>1000</batchMaxItems>
            </http>
            <format>
                <label>
                    <pattern>service=${SERVICE_NAME},level=%level,env=docker</pattern>
                </label>
                <message>
                    <pattern>level=%-5level traceId=%X{traceId:-none} spanId=%X{spanId:-none} thread=%thread logger=%logger{36} | %replace(%msg){'[\r\n]', ''}%nopex</pattern>
                </message>
                <sortByTime>true</sortByTime>
            </format>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOKI"/>
        </root>
    </springProfile>

</configuration>
