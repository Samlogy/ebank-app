{
  "spring.datasource.url":                              "jdbc:postgresql://CHANGE_ME_DB_HOST:5432/ebank_test",
  "spring.datasource.username":                         "CHANGE_ME_DB_USER",
  "spring.datasource.password":                         "CHANGE_ME_DB_PASSWORD",
  "spring.datasource.hikari.maximum-pool-size":         "10",
  "spring.datasource.hikari.minimum-idle":              "3",
  "spring.datasource.hikari.connection-timeout":        "3000",
  "spring.datasource.hikari.idle-timeout":              "300000",
  "spring.datasource.hikari.max-lifetime":              "900000",
  "spring.datasource.hikari.leak-detection-threshold":  "5000",
  "spring.jpa.hibernate.ddl-auto":                      "validate",
  "spring.jpa.show-sql":                                "false",
  "jwt.expiration":                                     "86400000",
  "admin.email":                                        "admin@test.ebank.com",
  "admin.password":                                     "CHANGE_ME_ADMIN_PASSWORD",
  "rate-limiting.login.capacity":                       "20",
  "rate-limiting.login.refill-minutes":                 "1",
  "logging.level.root":                                 "INFO",
  "logging.level.com.ebank":                            "DEBUG",
  "management.endpoints.web.exposure.include":          "health,info"
}
