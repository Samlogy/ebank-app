# ebank Environment Configuration
# Copy this file to .env and fill in the values

# ═══════════════════════════════════════════════════════════════════════════════
# PostgreSQL Configuration
# ═══════════════════════════════════════════════════════════════════════════════
POSTGRES_USER=ebank_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ebank_dev

# ═══════════════════════════════════════════════════════════════════════════════
# Redis Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Leave REDIS_PASSWORD blank for local dev (Docker container has no auth)
REDIS_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════════════
# Spring Boot Admin UI
# ═══════════════════════════════════════════════════════════════════════════════
ADMIN_UI_USER=admin
ADMIN_UI_PASSWORD=ChangeMe123!

# ═══════════════════════════════════════════════════════════════════════════════
# Spring Boot Application Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Admin seed user — leave blank to skip creation.
# Created once on first startup if the email doesn't already exist.
ADMIN_EMAIL=admin@ebank.com
ADMIN_PASSWORD=ChangeMe123!

# Spring Profiles
# - 'prod': Production mode (default), uses environment variables for config
# - 'dev': Development mode, reads config from Vault
# Use this when running with the 'vault' profile:
# SPRING_PROFILES_ACTIVE=dev
SPRING_PROFILES_ACTIVE=prod

# ═══════════════════════════════════════════════════════════════════════════════
# HashiCorp Vault Configuration (when using --profile vault)
# ═══════════════════════════════════════════════════════════════════════════════
# Uncomment and set these when running: docker compose --profile vault up -d

# VAULT_HOST=vault
# VAULT_PORT=8200
# VAULT_SCHEME=http
# VAULT_ENV_ID=E2
# SPRING_PROFILES_ACTIVE=dev

# For Vault Token Auth (local dev only):
# SPRING_CLOUD_VAULT_AUTHENTICATION=TOKEN
# SPRING_CLOUD_VAULT_TOKEN=root
# SPRING_CLOUD_VAULT_HOST=vault
# SPRING_CLOUD_VAULT_PORT=8200
# SPRING_CLOUD_VAULT_SCHEME=http

# ═══════════════════════════════════════════════════════════════════════════════
# ELK Stack Configuration (when using --profile elk)
# ═══════════════════════════════════════════════════════════════════════════════
# Logstash configuration for log forwarding
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5000

# ═══════════════════════════════════════════════════════════════════════════════
# Grafana Configuration (when using --profile monitoring)
# ═══════════════════════════════════════════════════════════════════════════════
GRAFANA_PASSWORD=admin

# ═══════════════════════════════════════════════════════════════════════════════
# Usage Examples
# ═══════════════════════════════════════════════════════════════════════════════
#
# 1. Basic stack (PostgreSQL + App only):
#    docker compose up -d
#
# 2. With ELK Stack (Elasticsearch, Logstash, Kibana):
#    docker compose --profile elk up -d
#    - Kibana UI: http://localhost:5601
#    - Elasticsearch API: http://localhost:9200
#
# 3. With HashiCorp Vault:
#    # First, set SPRING_PROFILES_ACTIVE=dev in this file
#    docker compose --profile vault up -d
#    - Vault UI: http://localhost:8200 (token: root)
#
# 4. With Monitoring Stack (Prometheus, Grafana, Tempo):
#    docker compose --profile monitoring up -d
#    - Grafana: http://localhost:3000 (admin / admin)
#    - Prometheus: http://localhost:9090
#    - Tempo API: http://localhost:3200
#
# 5. Complete stack (all services):
#    docker compose --profile vault --profile elk --profile monitoring up -d
#    or
#    docker compose --profile "*" up -d
#
# Stop stack:
#    docker compose down
#
# View logs:
#    docker compose logs -f app
#    docker compose logs -f vault
#    docker compose logs -f elasticsearch
#
# Clean up volumes:
#    docker compose down -v
