# ═══════════════════════════════════════════════════════════════════════════
#  Variables d'environnement — Stack Infrastructure CI/CD
#
#  Usage :
#    cp .env.example .env
#    nano .env    # adapter les valeurs
# ═══════════════════════════════════════════════════════════════════════════

# ── Ports (modifier si conflit avec d'autres services) ────────────────────
JENKINS_PORT=8090
SONARQUBE_PORT=9000

# ── SonarQube — Base de données PostgreSQL interne ───────────────────────
# Ces valeurs sont utilisées UNIQUEMENT en interne entre SonarQube et Postgres.
# Ne pas exposer Postgres à l'extérieur.
SONAR_DB_NAME=sonarqube
SONAR_DB_USER=sonarqube
SONAR_DB_PASSWORD=ChangeMe_SonarPass_2024!
