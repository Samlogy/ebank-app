# Production environment — copy to .env on the server, never commit real values
# cp .env.prod.example .env

# PostgreSQL
POSTGRES_USER=ebank_user
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=ebank_prod

# Admin seed user — created once on first startup if the email doesn't already exist
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=<strong-random-password>

# App image to pull (used by docker-compose.prod.yml)
APP_IMAGE=your-registry/ebank-monolith:1.0.0
