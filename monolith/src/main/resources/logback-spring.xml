<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- Registers %clr and other Spring Boot converters -->
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <!--
    Human-readable console — used by local/default and test profiles.
    Pattern includes correlationId and userId from MDC when present.
  -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%clr(%d{HH:mm:ss.SSS}){faint} %clr(%-5level){highlight} %clr([%X{correlationId:--}][uid:%X{userId:--}]){yellow} %clr(%-36.36logger{35}){cyan} %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- ── local / default (no active profile) ──────────────────────────────── -->
  <springProfile name="!(prod | test)">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
    <logger name="com.ebank"                    level="DEBUG"/>
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="org.hibernate.SQL"            level="WARN"/>
  </springProfile>

  <!-- ── test ─────────────────────────────────────────────────────────────── -->
  <springProfile name="test">
    <root level="WARN">
      <appender-ref ref="CONSOLE"/>
    </root>
    <logger name="com.ebank" level="INFO"/>
  </springProfile>

  <!-- ── prod ─────────────────────────────────────────────────────────────── -->
  <springProfile name="prod">

    <!--
      JSON to stdout: docker logs still works, and tools like Filebeat can
      pick it up too. Each line is a valid JSON document.
    -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <customFields>{"service":"ebank-monolith","env":"prod"}</customFields>
        <!-- MDC fields are included automatically by LogstashEncoder -->
      </encoder>
    </appender>

    <!--
      TCP socket to Logstash.
      - Async by default (internal ring buffer, events dropped if full).
      - Auto-reconnects every 10 s if Logstash is temporarily unavailable.
      - App startup is NOT blocked if Logstash is not yet ready.
    -->
    <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
      <destination>${LOGSTASH_HOST:-logstash}:${LOGSTASH_PORT:-5000}</destination>
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <customFields>{"service":"ebank-monolith","env":"prod"}</customFields>
      </encoder>
      <keepAliveDuration>5 minutes</keepAliveDuration>
      <reconnectionDelay>10 seconds</reconnectionDelay>
    </appender>

    <root level="INFO">
      <appender-ref ref="JSON_CONSOLE"/>
      <appender-ref ref="LOGSTASH"/>
    </root>
    <logger name="com.ebank"         level="INFO"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate"      level="WARN"/>
  </springProfile>

</configuration>
