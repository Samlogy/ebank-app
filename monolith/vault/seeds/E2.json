{
  "spring.datasource.url":                              "jdbc:postgresql://CHANGE_ME_DB_HOST:5432/ebank_test",
  "spring.datasource.username":                         "CHANGE_ME_DB_USER",
  "spring.datasource.password":                         "CHANGE_ME_DB_PASSWORD",
  "spring.datasource.hikari.maximum-pool-size":         "10",
  "spring.datasource.hikari.minimum-idle":              "3",
  "spring.datasource.hikari.connection-timeout":        "3000",
  "spring.datasource.hikari.idle-timeout":              "300000",
  "spring.datasource.hikari.max-lifetime":              "900000",
  "spring.datasource.hikari.leak-detection-threshold":  "5000",
  "spring.jpa.hibernate.ddl-auto":                      "validate",
  "spring.jpa.show-sql":                                "false",
  "spring.data.redis.host":                             "CHANGE_ME_REDIS_HOST",
  "spring.data.redis.port":                             "6379",
  "spring.data.redis.password":                         "CHANGE_ME_REDIS_PASSWORD",
  "spring.boot.admin.client.enabled":                   "true",
  "spring.boot.admin.client.url":                       "http://CHANGE_ME_ADMIN_HOST:8090",
  "spring.boot.admin.client.username":                  "CHANGE_ME_ADMIN_USER",
  "spring.boot.admin.client.password":                  "CHANGE_ME_ADMIN_PASSWORD",
  "spring.boot.admin.client.instance.service-base-url": "http://CHANGE_ME_APP_HOST:8080",
  "jwt.expiration":                                     "86400000",
  "admin.email":                                        "admin@test.ebank.com",
  "admin.password":                                     "CHANGE_ME_ADMIN_PASSWORD",
  "rate-limiting.login.capacity":                       "20",
  "rate-limiting.login.refill-minutes":                 "1",
  "logging.level.root":                                 "INFO",
  "logging.level.com.ebank":                            "DEBUG",
  "management.endpoints.web.exposure.include":          "health,info,metrics,prometheus,loggers,env,caches,threaddump,flyway,scheduledtasks"
}
